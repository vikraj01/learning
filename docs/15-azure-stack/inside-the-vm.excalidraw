      "updated": 1794073597422,
      "link": null,
      "locked": false,
      "text": "# 1. /etc/fstab\nUUID=3f6c2b1e-...  /mnt/data  ext4  defaults,nofail  0  2\n\n# 2. /etc/docker/daemon.json\n{ \"data-root\": \"/mnt/data/docker\" }\n# /etc/containerd/config.toml, first line\nroot = \"/mnt/data/containerd\"",
      "originalText": "# 1. /etc/fstab\nUUID=3f6c2b1e-...  /mnt/data  ext4  defaults,nofail  0  2\n\n# 2. /etc/docker/daemon.json\n{ \"data-root\": \"/mnt/data/docker\" }\n# /etc/containerd/config.toml, first line\nroot = \"/mnt/data/containerd\"",
      "fontSize": 16,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "7kegy5mtic4u",
