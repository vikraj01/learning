      "isDeleted": false,
      "boundElements": [],
      "updated": 1793018982715,
      "link": null,
      "locked": false,
      "text": "Way 1 is the usual Docker\nway: the app just reads\nprocess.env, and --env-file\nbehaves like -e.\n\nWay 2 is what happens with\napps that read .env\nthemselves (dotenv). The\nfile only fills gaps, so ENV\nin the Dockerfile wins.",
      "originalText": "Way 1 is the usual Docker\nway: the app just reads\nprocess.env, and --env-file\nbehaves like -e.\n\nWay 2 is what happens with\napps that read .env\nthemselves (dotenv). The\nfile only fills gaps, so ENV\nin the Dockerfile wins.",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "nefj7qxi6rhx",
      "autoResize": true,
      "lineHeight": 1.25
    },
