      "updated": 1793018982715,
      "link": null,
      "locked": false,
      "text": "docker run --rm -d -p 3000:3000 --env-file .env --name greet greet              # Way 1: pink\ndocker run --rm -d -p 3000:3000 -v \"$(pwd)/.env:/app/.env\" --name greet greet  # Way 2: light blue\ndocker exec greet ls -a                                                         # is .env inside?",
      "originalText": "docker run --rm -d -p 3000:3000 --env-file .env --name greet greet              # Way 1: pink\ndocker run --rm -d -p 3000:3000 -v \"$(pwd)/.env:/app/.env\" --name greet greet  # Way 2: light blue\ndocker exec greet ls -a                                                         # is .env inside?",
