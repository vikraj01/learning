      "boundElements": [],
      "updated": 1792780834306,
      "link": null,
      "locked": false,
      "text": "Request = a letter: 'please send me /'.\nResponse = the reply letter, starting with a\ncode: 200 OK, 404 Not Found...\n\nBig replies don't travel in one piece. They're\ncut into small numbered packets, like a long\nletter sent on many postcards. Your laptop\nputs the postcards back in order.",
      "originalText": "Request = a letter: 'please send me /'.\nResponse = the reply letter, starting with a\ncode: 200 OK, 404 Not Found...\n\nBig replies don't travel in one piece. They're\ncut into small numbered packets, like a long\nletter sent on many postcards. Your laptop\nputs the postcards back in order.",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "yf4r6mp6afqf",
      "autoResize": true,
      "lineHeight": 1.25
    },
