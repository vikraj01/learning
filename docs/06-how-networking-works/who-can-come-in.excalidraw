      "roundness": null,
      "seed": 1087089873,
      "version": 1,
      "versionNonce": 589504031,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792780833696,
      "link": null,
      "locked": false,
      "text": "127.0.0.1 = the intercom inside the building.\nOnly people already inside can use it.\n\n0.0.0.0 = the front door, open to the street.\nAnyone who knows the address can knock.\n\nDocker's -p 8080:80 opens the front door\n(0.0.0.0). -p 127.0.0.1:8080:80 keeps it to\nthe intercom.",
      "originalText": "127.0.0.1 = the intercom inside the building.\nOnly people already inside can use it.\n\n0.0.0.0 = the front door, open to the street.\nAnyone who knows the address can knock.\n\nDocker's -p 8080:80 opens the front door\n(0.0.0.0). -p 127.0.0.1:8080:80 keeps it to\nthe intercom.",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "6846p7q9m2i0",
      "autoResize": true,
      "lineHeight": 1.25
    },
