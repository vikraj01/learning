      "updated": 1792780833696,
      "link": null,
      "locked": false,
      "text": "python3 -m http.server 9003 --bind 127.0.0.1\npython3 -m http.server 9004 --bind 0.0.0.0\n\n# on your phone's browser:\nhttp://192.168.1.23:9004   # works\nhttp://192.168.1.23:9003   # can't connect",
      "originalText": "python3 -m http.server 9003 --bind 127.0.0.1\npython3 -m http.server 9004 --bind 0.0.0.0\n\n# on your phone's browser:\nhttp://192.168.1.23:9004   # works\nhttp://192.168.1.23:9003   # can't connect",
      "fontSize": 16,
      "fontFamily": 3,
