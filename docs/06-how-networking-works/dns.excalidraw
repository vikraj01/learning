      "boundElements": [],
      "updated": 1792780869676,
      "link": null,
      "locked": false,
      "text": "Like the contacts app on your\nphone: you tap 'Mum', and the\nphone dials her number. You never\ntype the number.\n\nYour laptop checks its own hosts\nfile first, then asks a DNS\nserver. A made-up name gets\n'NXDOMAIN': no such contact.",
      "originalText": "Like the contacts app on your\nphone: you tap 'Mum', and the\nphone dials her number. You never\ntype the number.\n\nYour laptop checks its own hosts\nfile first, then asks a DNS\nserver. A made-up name gets\n'NXDOMAIN': no such contact.",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "r2aqxv9upctn",
      "autoResize": true,
      "lineHeight": 1.25
    },
