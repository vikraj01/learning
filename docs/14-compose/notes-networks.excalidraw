    {
      "id": "tmo3oqsg5lo5",
      "type": "text",
      "x": 18,
      "y": 638,
      "width": 522.0,
      "height": 225.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1791126241,
      "version": 1,
      "versionNonce": 242309499,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793210684718,
      "link": null,
      "locked": false,
      "text": "A container can only find names on networks it has\njoined.\n\napi joined both, like a kitchen with one door to\nthe dining room and one to the pantry. web and db\nshare no network, so to web the name db doesn't\nexist.\n\nIf someone breaks into web, the database isn't\neven in sight.",
      "originalText": "A container can only find names on networks it has\njoined.\n\napi joined both, like a kitchen with one door to\nthe dining room and one to the pantry. web and db\nshare no network, so to web the name db doesn't\nexist.\n\nIf someone breaks into web, the database isn't\neven in sight.",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "5cv0xzmas6en",
      "autoResize": true,
      "lineHeight": 1.25
    },
