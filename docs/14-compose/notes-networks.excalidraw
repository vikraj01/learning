      "versionNonce": 726970232,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793210684718,
      "link": null,
      "locked": false,
      "text": "services:\n  web:  networks: [front]\n  api:  networks: [front, back]\n  db:   networks: [back]\nnetworks:\n  front:\n  back:",
      "originalText": "services:\n  web:  networks: [front]\n  api:  networks: [front, back]\n  db:   networks: [back]\nnetworks:\n  front:\n  back:",
