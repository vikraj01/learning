      "seed": 1113145427,
      "version": 1,
      "versionNonce": 831698693,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792688240625,
      "link": null,
      "locked": false,
      "text": "docker run -d --name box1 busybox:1.37 sleep 3600\ndocker run -d --name box2 busybox:1.37 sleep 3600\ndocker exec box2 ping -c 2 172.17.0.2     # works\ndocker exec box2 ping -c 1 box1           # ping: bad address 'box1'",
      "originalText": "docker run -d --name box1 busybox:1.37 sleep 3600\ndocker run -d --name box2 busybox:1.37 sleep 3600\ndocker exec box2 ping -c 2 172.17.0.2     # works\ndocker exec box2 ping -c 1 box1           # ping: bad address 'box1'",
      "fontSize": 16,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "8b7tfq7xkwo8",
      "autoResize": true,
      "lineHeight": 1.25
