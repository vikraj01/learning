      "boundElements": [],
      "updated": 1792688240625,
      "link": null,
      "locked": false,
      "text": "IP address = a room number.\nContainer name = the name on the\ndoor.\n\nOn the default network every\nroom has a number, but nobody\nkeeps a list of names. So box2\ncan reach 172.17.0.2, but 'box1'\nmeans nothing to it.",
      "originalText": "IP address = a room number.\nContainer name = the name on the\ndoor.\n\nOn the default network every\nroom has a number, but nobody\nkeeps a list of names. So box2\ncan reach 172.17.0.2, but 'box1'\nmeans nothing to it.",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "enyjqwx4hh53",
      "autoResize": true,
      "lineHeight": 1.25
    },
