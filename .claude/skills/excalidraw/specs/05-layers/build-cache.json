    {
      "style": "callout",
      "pos": [
        560,
        420
      ],
      "w": 420,
      "text": "Docker reuses a step (CACHED) only if the step and everything before it are exactly the same as last time.\n\nSo: things that rarely change go first (installing packages). Things you change all the time go last (your code)."
    },
    {
      "style": "code",
      "pos": [
        -40,
        780
      ],
      "text": "# after editing one line of app.js:\ndocker build -t layers-cow .                     # good: only step 5 runs\ndocker build -f Dockerfile.slow -t layers-cow-slow .  # bad: npm install runs again"
    }
  ]
