  "notes": [
    {
      "style": "callout",
      "pos": [
        920,
        470
      ],
      "w": 440,
      "text": "Same network = they can find each other by name (or by alias).\n\nDifferent network = they can't see each other at all. That's on purpose: it keeps things apart."
    },
    {
      "style": "code",
      "pos": [
        -50,
        470
      ],
      "text": "docker network create lab\ndocker run -d --name box1 --network lab busybox:1.37 sleep 3600\ndocker run -d --name box2 --network lab busybox:1.37 sleep 3600\ndocker run -d --name box3 --network lab --network-alias helper busybox:1.37 sleep 3600\ndocker exec box2 ping -c 2 box1      # works: Docker DNS answers 172.23.0.2"
    }
  ]
