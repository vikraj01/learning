    {
      "style": "callout",
      "pos": [
        1420,
        200
      ],
      "w": 330,
      "text": "Way 1 is the usual Docker way: the app just reads process.env, and --env-file behaves like -e.\n\nWay 2 is what happens with apps that read .env themselves (dotenv). The file only fills gaps, so ENV in the Dockerfile wins."
    },
    {
      "style": "code",
      "pos": [
        0,
        1160
      ],
      "text": "docker run --rm -d -p 3000:3000 --env-file .env --name greet greet              # Way 1: pink\ndocker run --rm -d -p 3000:3000 -v \"$(pwd)/.env:/app/.env\" --name greet greet  # Way 2: light blue\ndocker exec greet ls -a                                                         # is .env inside?"
    }
  ]
