      "text": "# Dockerfile (greet:3.0)\nFROM node:24-slim\nWORKDIR /app\nCOPY app.js say.js ./\nENV COLOR=lightblue\nEXPOSE 3000\nENTRYPOINT [\"node\"]\nCMD [\"app.js\"]"
